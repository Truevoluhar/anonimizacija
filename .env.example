AGENT_API_URL=http://host.docker.internal:8081
WORKSPACE_API_URL=http://host.docker.internal:8090
DATA_DIR=/data
MAX_UPLOAD_MB=40
# Production behind HTTPS: set true and provide the browser-facing origin.
COOKIE_SECURE=false
# PUBLIC_ORIGIN=https://anonimizacija.example.si

# ARM bootstrap; sfObjekt is the ARM application identifier.
ARM_APP_NAME=anonymizer_service
ARM_SETTINGS_URL=https://was-test.zpiz.si:9443/SFARSS002000/rest/v1/settings
ARM_TLS_VERIFY=true
ARM_CA_FILE=
ARM_CA_PATH=
ARM_CLIENT_CERT_FILE=
ARM_CLIENT_KEY_FILE=
ARM_CLIENT_KEY_PASSWORD=
